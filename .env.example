# Oros Health Data Pipeline Wizard - Environment Variables
# Copy this file to .env.local for local development

# AI/Agentic Features Toggle
# When true, enables AI-powered error analysis and suggestions
# When false, runs deterministically only
VITE_AI_ENABLED=false

# Backend API URL (for future use in Phase 2)
VITE_API_BASE_URL=http://localhost:3001

# Environment
VITE_ENVIRONMENT=development