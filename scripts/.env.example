# CKM Data Readiness — Scripts Environment
# ==========================================
# Copy this file to .env and fill in your actual connection strings.
# NEVER commit .env to GitHub — it is already in .gitignore.

# Direct connection (no pooler) — use for loading scripts and migrations
# Get this from Neon console: Connect → Connection pooling OFF → ckm_readiness
CKM_DIRECT=postgresql://neondb_owner:YOUR_PASSWORD@ep-autumn-dream-ad1au28g.c-2.us-east-1.aws.neon.tech/ckm_readiness?sslmode=require&channel_binding=require

# Pooler connection — use for app queries (future use)
# Get this from Neon console: Connect → Connection pooling ON → ckm_readiness
CKM_POOLER=postgresql://neondb_owner:YOUR_PASSWORD@ep-autumn-dream-ad1au28g-pooler.c-2.us-east-1.aws.neon.tech/ckm_readiness?sslmode=require&channel_binding=require
