{
  "name": "healthcare-pipeline-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "typecheck:inc": "tsc -p tsconfig.gate.json",
    "test": "vitest",
    "test:run": "vitest run",
    "load:config": "node scoring/lib/config_loader.js",
    "score:a": "node scoring/index.js --session A",
    "score:b": "node scoring/index.js --session B",
    "score:c": "node scoring/index.js --session C",
    "score:all": "node scoring/index.js --session all"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "dotenv": "^16.4.5",
    "papaparse": "^5.4.1",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.50",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3": "^7.4.3",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.4",
    "vitest": "^3.2.7"
  }
}
